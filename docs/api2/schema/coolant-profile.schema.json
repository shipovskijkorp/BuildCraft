{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildcraft.example/schema/api2/coolant-profile.schema.json",
  "title": "BuildCraft API 2 Coolant Profile",
  "type": "object",
  "required": ["selector", "degrees_per_mb"],
  "properties": {
    "selector": {
      "oneOf": [
        { "type": "object", "required": ["fluid"], "properties": { "fluid": { "type": "string" } }, "additionalProperties": false },
        { "type": "object", "required": ["tag"], "properties": { "tag": { "type": "string" } }, "additionalProperties": false }
      ]
    },
    "degrees_per_mb": { "type": "number", "exclusiveMinimum": 0 }
  },
  "additionalProperties": false
}
