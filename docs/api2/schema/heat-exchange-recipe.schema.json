{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildcraft.example/schema/api2/heat-exchange-recipe.schema.json",
  "title": "BuildCraft API 2 Heat Exchange Recipe",
  "type": "object",
  "required": ["kind", "input", "heat_from", "heat_to"],
  "properties": {
    "kind": { "enum": ["heating", "cooling"] },
    "input": {
      "type": "object",
      "required": ["fluid", "amount_mb"],
      "properties": {
        "fluid": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
        "amount_mb": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["fluid", "amount_mb"],
      "properties": {
        "fluid": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
        "amount_mb": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "heat_from": { "type": "integer" },
    "heat_to": { "type": "integer" }
  },
  "additionalProperties": false
}
