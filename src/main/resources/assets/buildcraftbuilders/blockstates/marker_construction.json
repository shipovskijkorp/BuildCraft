{
    "forge_marker": 1,
    "multipart": [
        {"when": {"facing":"up"},
            "apply" : {"model":"buildcraftbuilders:block/marker_construction"}},
        {"when": {"facing":"down"},
            "apply" : {"model":"buildcraftbuilders:block/marker_construction", "x":180 }},
        {"when": {"facing":"east"},
            "apply" : {"model":"buildcraftbuilders:block/marker_construction", "y":90, "x":90 }},
        {"when": {"facing":"south"},
            "apply" : {"model":"buildcraftbuilders:block/marker_construction", "y":180, "x":90 }},
        {"when": {"facing":"west"},
            "apply" : {"model":"buildcraftbuilders:block/marker_construction", "y":270, "x":90 }},
        {"when": {"facing":"north"},
            "apply" : {"model":"buildcraftbuilders:block/marker_construction", "x":90 }}
   ]
}
